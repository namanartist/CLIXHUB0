{
  "version": 2,
  "installCommand": "npm --prefix clix-main install",
  "buildCommand": "npm --prefix clix-main run build",
  "outputDirectory": "clix-main/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
